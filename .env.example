# ---------- Web / auth ----------
# Random string for signing the session cookie: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too
# Session lifetime in seconds (7 days)
SESSION_MAX_AGE=604800
# true when served over HTTPS (e.g. the Cloudflare tunnel). Browsers still accept it on http://localhost.
SESSION_HTTPS_ONLY=false
# Brute-force protection: failed logins per IP within the window (seconds)
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=300
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO

# ---------- Database ----------
# Default: SQLite file in ./data (Docker: /app/data volume)
# DATABASE_URL=sqlite+aiosqlite:///./data/crm.db
# PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://crm:crm@db:5432/crm

# Repeated message from a Telegram user whose last lead is done/rejected:
#   new_lead - create a new lead (default)
#   append   - add to the old lead and re-open it (status -> new)
REOPEN_POLICY=new_lead

# ---------- Telegram bot (from @BotFather) ----------
BOT_TOKEN=
# polling (default) or webhook
BOT_MODE=polling
# For BOT_MODE=webhook: public HTTPS URL of this app, e.g. https://crm.example.com
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/telegram/webhook
# Optional; generated automatically if empty
WEBHOOK_SECRET=

# ---------- Personal Telegram account (from https://my.telegram.org/apps) ----------
TG_API_ID=
TG_API_HASH=
# Default for "don't create leads from people in my contacts" (can be changed in the UI)
TG_IGNORE_CONTACTS=false
